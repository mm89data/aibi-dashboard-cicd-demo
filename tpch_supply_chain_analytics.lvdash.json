{
  "datasets": [
    {
      "name": "region",
      "displayName": "Regions",
      "config": {
        "version": "1.1",
        "source": "samples.tpch.region",
        "dimensions": [
          {
            "name": "r_regionkey",
            "expr": "r_regionkey",
            "comment": "Primary key"
          },
          {
            "name": "r_name",
            "expr": "r_name",
            "displayName": "Region"
          }
        ]
      }
    },
    {
      "name": "customer",
      "displayName": "Customers",
      "config": {
        "version": "1.1",
        "source": "samples.tpch.customer",
        "dimensions": [
          {
            "name": "c_custkey",
            "expr": "c_custkey",
            "comment": "Primary key"
          },
          {
            "name": "c_nationkey",
            "expr": "c_nationkey",
            "comment": "Nation key (FK to nation)"
          },
          {
            "name": "c_name",
            "expr": "c_name",
            "displayName": "Customer Name"
          },
          {
            "name": "c_mktsegment",
            "expr": "c_mktsegment",
            "displayName": "Market Segment"
          },
          {
            "name": "c_acctbal",
            "expr": "c_acctbal",
            "displayName": "Account Balance",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "measures": [
          {
            "name": "customer_count",
            "expr": "COUNT(DISTINCT c_custkey)",
            "displayName": "Customer Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_acctbal",
            "expr": "AVG(c_acctbal)",
            "displayName": "Avg Account Balance",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_acctbal",
            "expr": "SUM(c_acctbal)",
            "displayName": "Total Account Balance",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "nation",
      "displayName": "Nations",
      "config": {
        "version": "1.1",
        "source": "samples.tpch.nation",
        "dimensions": [
          {
            "name": "n_nationkey",
            "expr": "n_nationkey",
            "comment": "Primary key"
          },
          {
            "name": "n_regionkey",
            "expr": "n_regionkey",
            "comment": "Region key (FK to region)"
          },
          {
            "name": "n_name",
            "expr": "n_name",
            "displayName": "Nation"
          }
        ]
      }
    },
    {
      "name": "orders",
      "displayName": "Orders",
      "config": {
        "version": "1.1",
        "source": "samples.tpch.orders",
        "dimensions": [
          {
            "name": "o_orderkey",
            "expr": "o_orderkey",
            "comment": "Primary key"
          },
          {
            "name": "o_custkey",
            "expr": "o_custkey",
            "comment": "Customer key (FK to customer)"
          },
          {
            "name": "o_orderstatus",
            "expr": "o_orderstatus",
            "displayName": "Order Status",
            "comment": "F=Fulfilled, O=Open, P=Partial"
          },
          {
            "name": "o_orderdate",
            "expr": "o_orderdate",
            "displayName": "Order Date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "o_orderpriority",
            "expr": "o_orderpriority",
            "displayName": "Order Priority"
          },
          {
            "name": "o_clerk",
            "expr": "o_clerk",
            "displayName": "Clerk"
          },
          {
            "name": "order_year",
            "expr": "YEAR(o_orderdate)",
            "displayName": "Order Year"
          },
          {
            "name": "order_month",
            "expr": "DATE_TRUNC('MONTH', o_orderdate)",
            "displayName": "Order Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          }
        ],
        "measures": [
          {
            "name": "order_count",
            "expr": "COUNT(1)",
            "displayName": "Order Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_order_value",
            "expr": "SUM(o_totalprice)",
            "displayName": "Total Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(o_totalprice) / COUNT(1)",
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "supplier",
      "displayName": "Suppliers",
      "config": {
        "source": "samples.tpch.supplier",
        "measures": [
          {
            "name": "supplier_count",
            "expr": "COUNT(DISTINCT s_suppkey)",
            "displayName": "Supplier Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_supplier_acctbal",
            "expr": "AVG(s_acctbal)",
            "displayName": "Avg Supplier Balance",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "s_suppkey",
            "expr": "s_suppkey",
            "comment": "Primary key"
          },
          {
            "name": "s_name",
            "expr": "s_name",
            "displayName": "Supplier Name"
          },
          {
            "name": "s_nationkey",
            "expr": "s_nationkey",
            "comment": "Nation key"
          },
          {
            "name": "s_acctbal",
            "expr": "s_acctbal",
            "displayName": "Supplier Account Balance",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "supplier_nation",
            "expr": "nation.n_name",
            "displayName": "Supplier Nation"
          },
          {
            "name": "supplier_region",
            "expr": "nation.region.r_name",
            "displayName": "Supplier Region"
          }
        ],
        "joins": [
          {
            "name": "nation",
            "source": "samples.tpch.nation",
            "cardinality": "many_to_one",
            "on": "source.s_nationkey = nation.n_nationkey",
            "joins": [
              {
                "name": "region",
                "source": "samples.tpch.region",
                "cardinality": "many_to_one",
                "on": "nation.n_regionkey = region.r_regionkey",
                "rely": {
                  "atMostOneMatch": true
                }
              }
            ],
            "rely": {
              "atMostOneMatch": true
            }
          }
        ]
      }
    },
    {
      "name": "lineitem",
      "displayName": "Line Items",
      "config": {
        "version": "1.1",
        "source": "samples.tpch.lineitem",
        "dimensions": [
          {
            "name": "l_orderkey",
            "expr": "l_orderkey",
            "comment": "Order key (FK to orders)"
          },
          {
            "name": "l_suppkey",
            "expr": "l_suppkey",
            "comment": "Supplier key (FK to supplier)"
          },
          {
            "name": "l_shipdate",
            "expr": "l_shipdate",
            "displayName": "Ship Date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "l_commitdate",
            "expr": "l_commitdate",
            "displayName": "Commit Date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "l_receiptdate",
            "expr": "l_receiptdate",
            "displayName": "Receipt Date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "l_shipmode",
            "expr": "l_shipmode",
            "displayName": "Ship Mode"
          },
          {
            "name": "l_returnflag",
            "expr": "l_returnflag",
            "displayName": "Return Flag"
          },
          {
            "name": "l_linestatus",
            "expr": "l_linestatus",
            "displayName": "Line Status"
          },
          {
            "name": "ship_year",
            "expr": "YEAR(l_shipdate)",
            "displayName": "Ship Year"
          },
          {
            "name": "ship_month",
            "expr": "DATE_TRUNC('MONTH', l_shipdate)",
            "displayName": "Ship Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          }
        ],
        "measures": [
          {
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "total_revenue",
            "expr": "SUM(l_extendedprice * (1 - l_discount))",
            "comment": "Net revenue after discount"
          },
          {
            "name": "gross_revenue",
            "expr": "SUM(l_extendedprice)",
            "displayName": "Gross Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_quantity",
            "expr": "SUM(l_quantity)",
            "displayName": "Total Quantity",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_discount",
            "expr": "AVG(l_discount)",
            "displayName": "Avg Discount",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_discount_amount",
            "expr": "SUM(l_extendedprice * l_discount)",
            "displayName": "Total Discount Amount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_unit_price",
            "expr": "AVG(l_extendedprice / l_quantity)",
            "displayName": "Avg Unit Price",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "line_count",
            "expr": "COUNT(1)",
            "displayName": "Line Item Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "Regions",
          "datasetName": "region"
        },
        {
          "name": "Customers",
          "datasetName": "customer"
        },
        {
          "name": "Nations",
          "datasetName": "nation"
        },
        {
          "name": "Orders",
          "datasetName": "orders"
        },
        {
          "name": "Suppliers",
          "datasetName": "supplier"
        },
        {
          "name": "Line_Items",
          "datasetName": "lineitem"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "Line_Items",
          "to": "Orders",
          "on": "`Line_Items`.`l_orderkey` = `Orders`.`o_orderkey`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "Orders",
          "to": "Customers",
          "on": "`Orders`.`o_custkey` = `Customers`.`c_custkey`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_2",
          "from": "Customers",
          "to": "Nations",
          "on": "`Customers`.`c_nationkey` = `Nations`.`n_nationkey`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_3",
          "from": "Nations",
          "to": "Regions",
          "on": "`Nations`.`n_regionkey` = `Regions`.`r_regionkey`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_4",
          "from": "Line_Items",
          "to": "Suppliers",
          "on": "`Line_Items`.`l_suppkey` = `Suppliers`.`s_suppkey`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ],
      "measureExpressions": [
        {
          "name": "revenue_per_customer",
          "expression": "MEASURE(`Line_Items`.`total_revenue`) / MEASURE(`Customers`.`customer_count`)"
        },
        {
          "name": "revenue_per_supplier",
          "expression": "MEASURE(`Line_Items`.`total_revenue`) / MEASURE(`Suppliers`.`supplier_count`)"
        },
        {
          "name": "avg_items_per_order",
          "expression": "MEASURE(`Line_Items`.`line_count`) / MEASURE(`Orders`.`order_count`)"
        }
      ]
    }
  ],
