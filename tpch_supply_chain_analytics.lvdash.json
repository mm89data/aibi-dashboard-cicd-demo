    {
      "name": "global_filters",
      "displayName": "Global Filters",
      "layout": [
        {
          "widget": {
            "name": "filter_region",
            "queries": [
              {
                "name": "_Regions__r_name",
                "query": {
                  "fields": [
                    {
                      "name": "Regions__r_name",
                      "expression": "`Regions`.`r_name`"
                    },
                    {
                      "name": "Regions__r_name_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "showTitle": true,
